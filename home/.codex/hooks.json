{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "'__HOME__/.codex/hooks/rtk-rewrite.sh'",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '__HOME__/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
