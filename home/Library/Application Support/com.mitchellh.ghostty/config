# Ghostty config — consolidated single source of truth.
# (Replaces ~/.config/ghostty/config, the low-priority file whose duplicates
#  caused the earlier "theme didn't take" and "tabs disabled" issues.)

# ---- Appearance -------------------------------------------------------
theme = Catppuccin Mocha
font-family = JetBrains Mono
font-size = 16

# Tabs require window decorations (the titlebar) to be rendered.
window-decoration = true
# Custom titlebar with the tab strip integrated into it — matches the
# Catppuccin background for a seamless look.
macos-titlebar-style = tabs

background-opacity = 1
# (Blur disabled — opacity at 1 keeps the background fully solid.)
# Copy is on by default; kept explicit for documentation.
copy-on-select = true

# ---- Behavior ---------------------------------------------------------
# Left Option acts as Alt/Meta (enables emacs/readline/vim alt-bindings:
# Option+B back-word, Option+D kill-word, etc.). Right Option stays normal
# so Swedish layout characters work (@ { } [ ] | \ $ via Option).
macos-option-as-alt = left
# Restore tabs/splits across restarts.
window-save-state = always
# Fully quit when the last window closes (no lingering dock icon).
quit-after-last-window-closed = true
# New tabs append at the end of the tab list.
window-new-tab-position = end
# TEMPORARY: stable 1.3.1 breaks titlebar tabs on macOS 27 (ghostty#13070,
# fixed on tip by #13069). Switch back to stable once Ghostty >= 1.4 ships.
auto-update-channel = tip

# ---- Keybindings (ported from WezTerm) ----------------------------------
# WezTerm: SHIFT+Enter -> send \x1b[13;2u   (Kitty keyboard protocol)
keybind = shift+enter=text:\x1b[13;2u
# WezTerm: CTRL+q -> ToggleFullScreen
keybind = ctrl+q=toggle_fullscreen
# WezTerm: CTRL+' -> ClearScrollback 'ScrollbackAndViewport'
keybind = ctrl+quote=clear_screen